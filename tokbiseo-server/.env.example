# ============================================================
# 톡비서 서버 환경변수 템플릿
#
# 사용법:
#   1. 이 파일을 .env로 복사:  cp .env.example .env
#   2. 각 값을 실제 API 키로 채우기
#   3. docker compose up -d 로 서버 실행
# ============================================================

# ── 필수: API 접근 토큰 (외부 노출 보호) ──
# /api/* 엔드포인트는 이 토큰이 있어야 호출 가능 (요청 헤더 X-API-Key).
# 서버가 인터넷에 열려 있으므로 반드시 설정할 것. 없으면 /api/* 전부 503으로 막힘.
# 생성:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# TALKBISEO_API_KEY=아주_긴_랜덤_문자열

# ── 필수: OpenAI API 키 (LLM 호출용) ──
# 앱 설정에서도 입력 가능하지만, 여기에 넣으면 기본값으로 사용됨
# OPENAI_API_KEY=sk-...

# ── 선택: Tavily API 키 (웹 검색용) ──
# 없으면 웹 검색 단계를 건너뜀
# TAVILY_API_KEY=tvly-...

# ── 선택: YouTube Data API v3 키 (영상 검색용) ──
# 없으면 유튜브 검색 단계를 건너뜀
# YOUTUBE_API_KEY=AIza...

# ── 선택: Notion 연동 (리포트 자동 저장) ──
# 1. 아래 OAuth 정보 입력 후 서버 시작
# 2. 브라우저에서 인증 URL 접속 → Notion 허용
# 3. 콜백으로 access token이 자동 발급되어 여기에 저장됨
# 4. 이후 파이프라인 완료 시 리포트가 자동 저장
# NOTION_CLIENT_ID=31fd872b-...
# NOTION_CLIENT_SECRET=secret_...
# NOTION_DATABASE_ID=31f54df1357b...

# ── 선택: 티스토리 발행 (Notion 리포트 → 블로그 글) ──
# 블로그 이름: "myblog"이면 myblog.tistory.com
# 로그인 세션은 로컬에서 scripts/tistory_login.py 실행 후
# data/tistory_state.json 을 서버에 올려두면 됨 (README의 발행 절차 참고)
# TISTORY_BLOG_NAME=myblog
# TISTORY_STORAGE_STATE=data/tistory_state.json
# 글을 넣을 카테고리 이름 (에디터 드롭다운 표기와 동일하게, 없으면 기본 카테고리)
# TISTORY_CATEGORY=내 카테고리
# 매일 자동 발행 배치 시각 (기본 9 = 오전 9시 KST, 미발행 최신 글 1건 발행)
# TISTORY_BATCH_HOUR=9
# 세션 keep-alive 주기(시간) — 이 주기로 쿠키를 갱신해 세션 만료를 막음 (0 = 끔)
# TISTORY_KEEPALIVE_HOURS=3
# 세션이 완전히 죽었을 때 자동 재로그인용 카카오 계정 (선택)
# 캡차·카카오톡 2단계 인증이 뜨면 자동 로그인이 실패할 수 있음 → 그때만 수동 로그인
# KAKAO_EMAIL=me@example.com
# KAKAO_PASSWORD=비밀번호

# ── 선택: LangSmith 트레이싱 (디버깅/모니터링용) ──
# 없어도 서버는 정상 동작
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=tokbiseo

